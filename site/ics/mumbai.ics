BEGIN:VEVENT
UID:occ-venus-2026-09-14-mumbai@occult.alokm.com
DTSTAMP:20260914T034332Z
DTSTART:20260914T114047Z
DTEND:20260914T124757Z
SUMMARY:The Moon occults Venus
DESCRIPTION:Venus disappears at 17:13:40 and reappears at 18:15:13 IST\, se
 en from Mumbai.\nThe Moon is 41° up in the SW · daylight\, Sun +20°.\nT
 imes against the real lunar limb.\nMap\, timings and the view at the Moon'
 s edge: https://occult.alokm.com/venus-2026-09-14?city=Mumbai
URL:https://occult.alokm.com/venus-2026-09-14?city=Mumbai
TRANSP:TRANSPARENT
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:The Moon occults Venus
TRIGGER:-PT30M
END:VALARM
END:VEVENT
