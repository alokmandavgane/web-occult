BEGIN:VEVENT
UID:occ-venus-2026-09-14-nashik@occult.alokm.com
DTSTAMP:20260914T034332Z
DTSTART:20260914T114412Z
DTEND:20260914T124552Z
SUMMARY:The Moon occults Venus
DESCRIPTION:Venus disappears at 17:17:19 and reappears at 18:13:00 IST\, se
 en from Nashik.\nThe Moon is 39° up in the SW · daylight\, Sun +18°.\nT
 imes against the real lunar limb.\nMap\, timings and the view at the Moon'
 s edge: https://occult.alokm.com/venus-2026-09-14?city=Nashik
URL:https://occult.alokm.com/venus-2026-09-14?city=Nashik
TRANSP:TRANSPARENT
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:The Moon occults Venus
TRIGGER:-PT30M
END:VALARM
END:VEVENT
